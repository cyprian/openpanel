#!/bin/bash
set -euo pipefail

SELF_HOSTING_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "$SELF_HOSTING_DIR/.." && pwd)"

cd "$REPO_DIR"
git pull

if [ -f "$SELF_HOSTING_DIR/caddy/Caddyfile" ] &&
  { ! grep -q "handle /ml\\*" "$SELF_HOSTING_DIR/caddy/Caddyfile" ||
    ! grep -q "handle /packages\\*" "$SELF_HOSTING_DIR/caddy/Caddyfile"; }; then
  echo "Adding API passthrough routes to Caddyfile"
  HAS_ML=0
  HAS_PACKAGES=0
  grep -q "handle /ml\\*" "$SELF_HOSTING_DIR/caddy/Caddyfile" && HAS_ML=1
  grep -q "handle /packages\\*" "$SELF_HOSTING_DIR/caddy/Caddyfile" && HAS_PACKAGES=1
  awk '
    { print }
    $0 ~ /handle_path \/api\*/ { in_api = 1 }
    in_api && $0 ~ /^[[:space:]]*}[[:space:]]*$/ {
      if (has_ml == "0") {
        print ""
        print "    handle /ml* {"
        print "        reverse_proxy op-api:3000"
        print "    }"
      }
      if (has_packages == "0") {
        print ""
        print "    handle /packages* {"
        print "        reverse_proxy op-api:3000"
        print "    }"
      }
      in_api = 0
    }
  ' has_ml="$HAS_ML" has_packages="$HAS_PACKAGES" \
    "$SELF_HOSTING_DIR/caddy/Caddyfile" > "$SELF_HOSTING_DIR/caddy/Caddyfile.tmp"
  mv "$SELF_HOSTING_DIR/caddy/Caddyfile.tmp" "$SELF_HOSTING_DIR/caddy/Caddyfile"
fi

if [ -f "$SELF_HOSTING_DIR/docker-compose.yml" ] &&
  ! grep -q "op-ml-storage" "$SELF_HOSTING_DIR/docker-compose.yml"; then
  echo "Adding persistent ML storage volume to docker-compose.yml"
  awk '
    /^  op-api:/ { in_api = 1 }
    in_api && /^    command:/ {
      print "    volumes:"
      print "      - op-ml-storage:/var/lib/openpanel/ml"
      in_api = 0
    }
    { print }
  ' "$SELF_HOSTING_DIR/docker-compose.yml" > "$SELF_HOSTING_DIR/docker-compose.yml.tmp"
  mv "$SELF_HOSTING_DIR/docker-compose.yml.tmp" "$SELF_HOSTING_DIR/docker-compose.yml"
  cat >> "$SELF_HOSTING_DIR/docker-compose.yml" <<'EOF'
  op-ml-storage:
    driver: local
EOF
fi

if [ -f "$SELF_HOSTING_DIR/docker-compose.yml" ] &&
  ! grep -q "op-package-registry-storage" "$SELF_HOSTING_DIR/docker-compose.yml"; then
  echo "Adding persistent package registry storage volume to docker-compose.yml"
  awk '
    /^  op-api:/ { in_api = 1 }
    in_api && /^[[:space:]]*- op-ml-storage:\/var\/lib\/openpanel\/ml/ {
      print
      print "      - op-package-registry-storage:/var/lib/openpanel/packages"
      next
    }
    { print }
  ' "$SELF_HOSTING_DIR/docker-compose.yml" > "$SELF_HOSTING_DIR/docker-compose.yml.tmp"
  mv "$SELF_HOSTING_DIR/docker-compose.yml.tmp" "$SELF_HOSTING_DIR/docker-compose.yml"
  cat >> "$SELF_HOSTING_DIR/docker-compose.yml" <<'EOF'
  op-package-registry-storage:
    driver: local
EOF
fi

echo "Building OpenPanel images from local source"
docker build -f apps/api/Dockerfile -t lindesvard/openpanel-api:2 .
docker build -f apps/worker/Dockerfile -t lindesvard/openpanel-worker:2 .
docker build -f apps/start/Dockerfile -t lindesvard/openpanel-dashboard:2 .

cd "$SELF_HOSTING_DIR"

echo "Pulling infrastructure images"
docker compose pull op-proxy op-db op-kv op-ch

echo "Updating services"
docker compose up -d --remove-orphans --force-recreate op-api op-worker op-dashboard
docker compose up -d --remove-orphans
docker compose up -d --no-deps --force-recreate op-proxy

echo "Done"
